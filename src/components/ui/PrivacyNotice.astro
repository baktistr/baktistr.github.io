<div
  id="analytics-consent"
  class="hidden fixed inset-0 z-[70] flex items-center justify-center overflow-y-auto bg-slate-950/80 p-4 backdrop-blur-sm light:bg-slate-900/50"
>
  <div
    id="analytics-consent-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="analytics-consent-title"
    tabindex="-1"
    class="w-full max-w-lg rounded-xl border border-slate-700 bg-slate-900 p-6 text-sm text-slate-200 shadow-2xl light:border-slate-200 light:bg-white light:text-slate-700"
  >
    <h2 id="analytics-consent-title" class="mb-2 text-lg font-semibold text-slate-100 light:text-slate-900">
      Analytics preferences
    </h2>
    <p>
      May we load Cloudflare Insights to measure visits and page performance? It is optional and stays off
      unless you allow it. <a href="/privacy" class="text-cyan-400 underline underline-offset-2 hover:text-cyan-300 light:text-cyan-700 light:hover:text-cyan-600">Privacy details</a>.
    </p>
    <p id="analytics-consent-status" class="mt-3 text-xs text-slate-400 light:text-slate-500" aria-live="polite"></p>
    <div class="mt-5 flex flex-wrap gap-2">
      <button
        id="analytics-consent-reject"
        type="button"
        class="rounded-md border border-slate-500 px-3 py-1.5 font-medium text-slate-100 hover:bg-slate-800 light:border-slate-400 light:text-slate-900 light:hover:bg-slate-100"
      >
        Reject analytics
      </button>
      <button
        id="analytics-consent-allow"
        type="button"
        class="rounded-md border border-slate-500 px-3 py-1.5 font-medium text-slate-100 hover:bg-slate-800 light:border-slate-400 light:text-slate-900 light:hover:bg-slate-100"
      >
        Allow analytics
      </button>
    </div>
  </div>
</div>

<script>
  const notice = document.getElementById('analytics-consent');
  const panel = document.getElementById('analytics-consent-panel');
  const allowButton = document.getElementById('analytics-consent-allow');
  const rejectButton = document.getElementById('analytics-consent-reject');
  const settingsButton = document.getElementById('privacy-settings-open');
  const status = document.getElementById('analytics-consent-status');
  const storageKey = 'analytics-consent';

  if (notice && panel && allowButton && rejectButton) {
    let choice: string | null = null;
    try {
      choice = localStorage.getItem(storageKey);
    } catch (_) {
      // A visitor can still choose for this page when storage is unavailable.
    }

    const updateStatus = () => {
      if (status) status.textContent = choice === 'allow'
        ? 'Current choice: analytics allowed.'
        : choice === 'reject'
          ? 'Current choice: analytics rejected.'
          : 'No choice saved yet.';
    };

    const openNotice = () => {
      notice.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      updateStatus();
      rejectButton.focus();
    };

    const closeNotice = () => {
      notice.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    if (choice !== 'allow' && choice !== 'reject') openNotice();
    updateStatus();

    settingsButton?.addEventListener('click', openNotice);

    // Dismiss on backdrop click or Escape; the choice stays unsaved and is asked again.
    notice.addEventListener('click', (event) => {
      if (event.target === notice) closeNotice();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !notice.classList.contains('hidden')) {
        closeNotice();
        settingsButton?.focus();
      }
    });

    // Keep keyboard focus inside the dialog while it is open.
    panel.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const focusable = panel.querySelectorAll<HTMLElement>('a[href], button');
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const saveChoice = (value: 'allow' | 'reject') => {
      choice = value;
      try {
        localStorage.setItem(storageKey, value);
      } catch (_) {}
      closeNotice();
    };

    allowButton.addEventListener('click', () => {
      saveChoice('allow');
      window.dispatchEvent(new Event('site:analytics-consent-granted'));
    });

    rejectButton.addEventListener('click', () => {
      const beaconWasLoaded = Boolean(document.querySelector('script[data-consent-analytics]'));
      saveChoice('reject');
      // A loaded script cannot be unloaded; reload to stop it on this page.
      if (beaconWasLoaded) window.location.reload();
    });
  }
</script>
