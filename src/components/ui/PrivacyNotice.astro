<aside
  id="analytics-consent"
  class="hidden fixed inset-x-0 bottom-0 z-[70] border-t border-slate-700 bg-slate-900 text-sm text-slate-200 shadow-2xl light:border-slate-200 light:bg-white light:text-slate-700"
  aria-labelledby="analytics-consent-title"
>
  <div class="container mx-auto flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 id="analytics-consent-title" class="font-semibold text-slate-100 light:text-slate-900">
        Analytics preferences
      </h2>
      <p class="mt-1">
        May we load Cloudflare Insights to measure visits and page performance? It is optional and stays off
        unless you allow it. <a href="/privacy" class="text-cyan-400 underline underline-offset-2 hover:text-cyan-300 light:text-cyan-700 light:hover:text-cyan-600">Privacy details</a>.
      </p>
      <p id="analytics-consent-status" class="mt-1 text-xs text-slate-400 light:text-slate-500" aria-live="polite"></p>
    </div>
    <div class="flex flex-shrink-0 flex-wrap gap-2">
      <button
        id="analytics-consent-reject"
        type="button"
        class="rounded-md border border-slate-500 px-3 py-1.5 font-medium text-slate-100 hover:bg-slate-800 light:border-slate-400 light:text-slate-900 light:hover:bg-slate-100"
      >
        Reject analytics
      </button>
      <button
        id="analytics-consent-allow"
        type="button"
        class="rounded-md border border-slate-500 px-3 py-1.5 font-medium text-slate-100 hover:bg-slate-800 light:border-slate-400 light:text-slate-900 light:hover:bg-slate-100"
      >
        Allow analytics
      </button>
    </div>
  </div>
</aside>

<script>
  const notice = document.getElementById('analytics-consent');
  const allowButton = document.getElementById('analytics-consent-allow');
  const rejectButton = document.getElementById('analytics-consent-reject');
  const settingsButton = document.getElementById('privacy-settings-open');
  const status = document.getElementById('analytics-consent-status');
  const storageKey = 'analytics-consent';

  if (notice && allowButton && rejectButton) {
    let choice: string | null = null;
    try {
      choice = localStorage.getItem(storageKey);
    } catch (_) {
      // A visitor can still choose for this page when storage is unavailable.
    }

    const updateStatus = () => {
      if (status) status.textContent = choice === 'allow'
        ? 'Current choice: analytics allowed.'
        : choice === 'reject'
          ? 'Current choice: analytics rejected.'
          : 'No choice saved yet.';
    };

    if (choice !== 'allow' && choice !== 'reject') notice.classList.remove('hidden');
    updateStatus();

    settingsButton?.addEventListener('click', () => {
      notice.classList.remove('hidden');
      updateStatus();
      rejectButton.focus();
    });

    const saveChoice = (value: 'allow' | 'reject') => {
      choice = value;
      try {
        localStorage.setItem(storageKey, value);
      } catch (_) {}
      notice.classList.add('hidden');
    };

    allowButton.addEventListener('click', () => {
      saveChoice('allow');
      window.dispatchEvent(new Event('site:analytics-consent-granted'));
    });

    rejectButton.addEventListener('click', () => {
      const beaconWasLoaded = Boolean(document.querySelector('script[data-consent-analytics]'));
      saveChoice('reject');
      // A loaded script cannot be unloaded; reload to stop it on this page.
      if (beaconWasLoaded) window.location.reload();
    });
  }
</script>
