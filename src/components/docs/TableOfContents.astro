---
import TocList from './TocList.astro';

interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
  currentHeading: string;
}

const { headings, currentHeading } = Astro.props;
---

<!-- Desktop Sidebar -->
<aside class="docs-toc hidden xl:block shrink-0 sticky top-20 h-[calc(100vh-5rem)] overflow-y-auto pl-6 border-l border-slate-800 light:border-slate-200 sidebar-scroll">
  <nav>
    <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
      On this page
    </h4>
    <TocList headings={headings} currentHeading={currentHeading} idPrefix="desktop" />
  </nav>
</aside>

<!-- Mobile Modal -->
<div
  id="toc-modal-backdrop"
  class="xl:hidden fixed inset-0 bg-black/50 light:bg-white/50 opacity-0 pointer-events-none transition-opacity"
  aria-hidden="true"
></div>

<div
  id="toc-modal"
  class="xl:hidden fixed inset-x-4 bottom-4 top-auto max-h-[70vh] bg-slate-950 light:bg-white border border-slate-800 light:border-slate-200 z-50 rounded-lg shadow-2xl transform scale-95 opacity-0 pointer-events-none transition-all duration-150 ease-in-out flex flex-col"
  role="dialog"
  aria-modal="true"
  aria-label="Table of contents"
>
  <div class="sticky top-0 bg-slate-950 light:bg-white border-b border-slate-800 light:border-slate-200 z-10 px-4 py-3 flex items-center justify-between shrink-0">
    <h2 class="text-lg font-semibold text-slate-100 light:text-slate-900">On this page</h2>
    <button
      id="toc-modal-close"
      class="p-1 rounded-md text-slate-400 light:text-slate-600 hover:text-slate-100 light:hover:text-slate-900 hover:bg-slate-800 light:hover:bg-slate-100 transition-colors"
      aria-label="Close table of contents"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="p-4 overflow-y-auto flex-1">
    <TocList headings={headings} currentHeading={currentHeading} idPrefix="mobile" />
  </nav>
</div>

<script>
  function setTocSectionOpen(toggle: HTMLButtonElement, open: boolean) {
    const sectionId = toggle.getAttribute('aria-controls');
    const children = sectionId ? document.getElementById(sectionId) : null;
    if (!children) return;

    const heading = toggle.dataset.heading ?? 'this section';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', `${open ? 'Hide' : 'Show'} subsections for ${heading}`);
    children.classList.toggle('hidden', !open);
    toggle.querySelector('.toc-section-chevron')?.classList.toggle('rotate-90', open);
  }

  function openTocPath(slug: string) {
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    document.querySelectorAll<HTMLButtonElement>('.toc-section-toggle').forEach((toggle) => {
      setTocSectionOpen(toggle, false);
    });

    tocLinks.forEach((link) => {
      const isActive = link.dataset.tocSlug === slug;
      link.dataset.active = String(isActive);
      if (!isActive) return;

      let node = link.closest<HTMLElement>('.toc-node');
      while (node) {
        const row = node.firstElementChild;
        const ownToggle = row?.querySelector<HTMLButtonElement>('.toc-section-toggle');
        if (ownToggle) setTocSectionOpen(ownToggle, true);

        const parentList = node.parentElement;
        if (!parentList?.classList.contains('toc-section-children')) break;
        const parentToggle = document.querySelector<HTMLButtonElement>(
          `.toc-section-toggle[aria-controls="${parentList.id}"]`
        );
        if (parentToggle) setTocSectionOpen(parentToggle, true);
        node = parentList.closest<HTMLElement>('.toc-node');
      }
    });
  }

  function initTocSections() {
    document.querySelectorAll<HTMLButtonElement>('.toc-section-toggle:not([data-initialized])').forEach((toggle) => {
      toggle.dataset.initialized = 'true';
      toggle.addEventListener('click', () => {
        const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
        setTocSectionOpen(toggle, willOpen);
      });
    });

    if (document.body.dataset.tocScrollInitialized === 'true') return;
    document.body.dataset.tocScrollInitialized = 'true';

    const articleHeadings = Array.from(
      document.querySelectorAll<HTMLElement>('article h1[id], article h2[id], article h3[id]')
    );
    let frameRequested = false;

    function updateTocFromScroll() {
      frameRequested = false;
      if (articleHeadings.length === 0) return;

      const marker = Math.min(180, window.innerHeight * 0.25);
      let activeHeading = articleHeadings[0];
      for (const heading of articleHeadings) {
        if (heading.getBoundingClientRect().top <= marker) activeHeading = heading;
        else break;
      }
      openTocPath(activeHeading.id);
    }

    window.addEventListener('scroll', () => {
      if (frameRequested) return;
      frameRequested = true;
      window.requestAnimationFrame(updateTocFromScroll);
    }, { passive: true });

    const hash = decodeURIComponent(window.location.hash.slice(1));
    if (hash) openTocPath(hash);
  }

  document.addEventListener('DOMContentLoaded', initTocSections);
  document.addEventListener('astro:page-load', initTocSections);
</script>

<style>
  @media (min-width: 1280px) {
    .docs-toc {
      --right-gutter: min(calc(50vw - 640px), 12rem);
      width: calc(16rem + var(--right-gutter));
      margin-right: calc(0px - var(--right-gutter));
    }
  }

  @media (min-width: 1536px) {
    .docs-toc {
      --right-gutter: min(calc(50vw - 768px), 12rem);
    }
  }

  :global(.toc-link[data-active='true']) {
    color: rgb(34 211 238);
    border-left-color: rgb(34 211 238);
    font-weight: 500;
  }

  :global(html.light .toc-link[data-active='true']) {
    color: rgb(8 145 178);
    border-left-color: rgb(8 145 178);
  }
</style>
